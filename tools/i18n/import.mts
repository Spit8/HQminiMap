// Writes the translations of lowCost_Translator's units mode (tools/i18n/out/<lang>.json, flat
// {id: text}) into the app (app/src/lib/i18n/<lang>.ts, same layout as fr.ts) and the mod
// (generated <lang> tables of mod/content/hqminimap/i18n.lua).
// Run from app/: npx tsx ../tools/i18n/import.mts [de,it,es,zh]
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const here = dirname(fileURLToPath(import.meta.url));
const root = join(here, "..", "..");
const LANGS: Record<string, { name: string; label: string }> = {
  de: { name: "Deutsch", label: "German" },
  it: { name: "Italiano", label: "Italian" },
  es: { name: "Español", label: "Spanish" },
  zh: { name: "简体中文", label: "Simplified Chinese" },
};
const langs = (process.argv[2] ?? Object.keys(LANGS).join(",")).split(",").filter((l) => l in LANGS);

/** Per-language fix-ups the model may miss (the game's own conventions). */
function polish(lang: string, s: string): string {
  // The game's German uses Swiss orthography (ss, no ß).
  return lang === "de" ? s.replaceAll("ß", "ss") : s;
}

const frSrc = readFileSync(join(root, "app", "src", "lib", "i18n", "fr.ts"), "utf8");
const luaPath = join(root, "mod", "content", "hqminimap", "i18n.lua");
let lua = readFileSync(luaPath, "utf8");
const nl = lua.includes("\r\n") ? "\r\n" : "\n";

for (const lang of langs) {
  const tr = JSON.parse(readFileSync(join(here, "out", `${lang}.json`), "utf8")) as Record<string, string>;
  const missing: string[] = [];
  // App: fr.ts line by line (same order and blank lines), each value replaced.
  const body: string[] = [];
  const lines = frSrc.split(/\r?\n/);
  const start = lines.findIndex((l) => l.startsWith("export const fr = {"));
  const end = lines.findIndex((l, i) => i > start && l.startsWith("} as const;"));
  for (const line of lines.slice(start + 1, end)) {
    const m = /^(\s*)"([^"]+)":\s*".*",?\s*$/.exec(line);
    if (!m) {
      body.push(line);
      continue;
    }
    const key = m[2]!;
    let v = key === "lang.name" ? LANGS[lang]!.name : tr[`app:${key}`];
    if (v === undefined) {
      missing.push(key);
      continue;
    }
    body.push(`${m[1]}${JSON.stringify(key)}: ${JSON.stringify(polish(lang, v))},`);
  }
  if (missing.length) throw new Error(`${lang}: missing ${missing.length} app keys (${missing.slice(0, 5).join(", ")}…)`);
  const ts = [
    `/** ${LANGS[lang]!.label} UI strings, generated by tools/i18n/import.mts from lowCost_Translator (do not edit: fix the`,
    ` * glossary, the context or tools/i18n/overrides.json, then translate and import again). */`,
    `import type { MessageKey } from "./fr";`,
    ``,
    `export const ${lang}: Record<MessageKey, string> = {`,
    ...body,
    `};`,
    ``,
  ].join("\n");
  writeFileSync(join(root, "app", "src", "lib", "i18n", `${lang}.ts`), ts);

  // Mod: a generated table between markers, replaced on each import.
  const modKeys = Object.keys(tr).filter((id) => id.startsWith("mod:"));
  const esc = (s: string) => s.replaceAll("\\", "\\\\").replaceAll('"', '\\"');
  const block = [
    `\t-- BEGIN generated ${lang} (tools/i18n/import.mts)`,
    `\t${lang} = {`,
    ...modKeys.map((id) => `\t\t${id.slice(4)} = "${esc(polish(lang, tr[id]!))}",`),
    `\t},`,
    `\t-- END generated ${lang}`,
  ].join(nl);
  const re = new RegExp(`\\t-- BEGIN generated ${lang} [\\s\\S]*?-- END generated ${lang}`);
  if (re.test(lua)) lua = lua.replace(re, block);
  else {
    // Before the closing brace of the STRINGS table.
    const close = lua.indexOf(`${nl}}${nl}`, lua.indexOf("local STRINGS = {"));
    if (close < 0) throw new Error("i18n.lua: end of STRINGS not found");
    lua = lua.slice(0, close) + nl + block + lua.slice(close);
  }
  console.log(`${lang}: app ${body.filter((l) => l.includes('": ')).length} keys, mod ${modKeys.length} keys`);
}
writeFileSync(luaPath, lua);
