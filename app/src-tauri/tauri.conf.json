{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HQminiMap",
  "version": "0.2.0",
  "identifier": "com.hqminimap.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HQminiMap",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1Mzc3RTRCOTg1RDEyNzQKUldSMEVsMllTMzQzMVcwKzgxdVZiVzBnRGRJa1RxUCtXNVhSQUtMRlNnSTR1cE5pd292WjhIUXMK",
      "endpoints": [
        "https://github.com/Spit8/HQminiMap/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Carte haute qualité pour Transport Fever 3",
    "publisher": "Wilfried Lambert",
    "copyright": "© 2026 Wilfried Lambert — GPL-3.0",
    "homepage": "https://github.com/Spit8/HQminiMap",
    "category": "Utility",
    "license": "GPL-3.0-only",
    "longDescription": "Application compagnon du mod HQminiMap pour Transport Fever 3 : calcul de la grille de capture, orthomosaïque haute résolution et visualiseur interactif des données en direct du jeu (villes, industries, gares, lignes, véhicules).",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
